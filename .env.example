# Copy this file to .env and replace every placeholder with a secret stored
# outside source control.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
AvalAI_ApiKey=replace-with-your-ai-provider-api-key
Sms_ApiKey=replace-with-your-sms-provider-api-key