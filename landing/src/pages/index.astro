---
import "../styles/landing.css";
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>همکار | شبکه همکاری فروشندگان</title>
		<meta
			name="description"
			content="همکار، شبکه‌ای برای ارتباط فروشندگان و دسترسی به قیمت‌های واقعی بازار."
		/>
		<script>
			const header = document.querySelector(".header");

			const updateHeader = () => {
				header?.classList.toggle("scrolled", window.scrollY > 10);
			};

			updateHeader();
			window.addEventListener("scroll", updateHeader, { passive: true });
		</script></head
	>

	<body>
		<main class="landing">
			<!-- Background -->
			<div class="bg-glow bg-glow-top"></div>
			<div class="bg-glow bg-glow-bottom"></div>
			<div class="bg-orbit orbit-one"></div>
			<div class="bg-orbit orbit-two"></div>

			<!-- Header -->
			<header class="header">
				<div class="header-inner">
					<a href="/" class="brand">
						<svg
							class="brand-logo"
							viewBox="0 0 80 64"
							xmlns="http://www.w3.org/2000/svg"
							aria-label="همکار"
						>
							<defs>
								<linearGradient
									id="hamkar-left"
									x1="5"
									y1="8"
									x2="42"
									y2="58"
									gradientUnits="userSpaceOnUse"
								>
									<stop offset="0" stop-color="#22E4FF"
									></stop>
									<stop offset="0.55" stop-color="#159BFF"
									></stop>
									<stop offset="1" stop-color="#4B5CFF"
									></stop>
								</linearGradient>

								<linearGradient
									id="hamkar-right"
									x1="38"
									y1="8"
									x2="75"
									y2="58"
									gradientUnits="userSpaceOnUse"
								>
									<stop offset="0" stop-color="#5364FF"
									></stop>
									<stop offset="0.55" stop-color="#684BFF"
									></stop>
									<stop offset="1" stop-color="#913CFF"
									></stop>
								</linearGradient>
							</defs>

							<!-- سر چپ -->
							<circle
								cx="25"
								cy="14"
								r="11"
								fill="url(#hamkar-left)"></circle>

							<!-- سر راست -->
							<circle
								cx="55"
								cy="14"
								r="11"
								fill="url(#hamkar-right)"></circle>

							<!-- فرم پایین چپ -->
							<path
								d="
                M 8 39
                C 8 31.3 14.3 25 22 25
                H 28
                C 35.7 25 42 31.3 42 39
                V 42
                C 42 49.7 35.7 56 28 56
                H 22
                C 14.3 56 8 49.7 8 42
                Z
            "
								fill="url(#hamkar-left)"></path>

							<!-- فرم پایین راست -->
							<path
								d="
                M 38 39
                C 38 31.3 44.3 25 52 25
                H 58
                C 65.7 25 72 31.3 72 39
                V 42
                C 72 49.7 65.7 56 58 56
                H 52
                C 44.3 56 38 49.7 38 42
                Z
            "
								fill="url(#hamkar-right)"></path>

							<!-- حفره‌ی مرکزی لوگو -->
							<circle cx="40" cy="40" r="9.5" fill="#06122F"
							></circle>
						</svg>

						<span class="brand-name">همکار</span>
					</a>

					<nav class="nav">
						<a href="#introduction">معرفی</a>
						<a href="#how-it-works">نحوه کار</a>
						<a href="#for-sellers">امکانات</a>
						<a href="#access-control">امنیت و دسترسی</a>
					</nav>

					<div class="header-actions">
						<a
							href="https://app.hamkar.shop/login"
							class="btn btn-outline">ورود</a
						>
						<a
							href="https://app.hamkar.shop/register"
							class="btn btn-primary btn-small"
						>
							ثبت‌نام
						</a>
					</div>
				</div>
			</header>

			<!-- Hero -->
			<section class="hero">
				<div class="hero-content">
					<div class="eyebrow">شبکه همکاران فروش</div>

					<h1>
						قیمت واقعی بازار
						<span>از همکارانت بپرس.</span>
					</h1>

					<p class="hero-description">
						همکار پلتفرمی برای ارتباط مستقیم فروشندگان و دسترسی سریع
						به قیمت‌های به‌روز و واقعی بازار است.
					</p>

					<div class="hero-actions">
						<a
							href="https://app.hamkar.shop/register"
							class="btn btn-primary btn-large"
						>
							همین حالا ثبت‌نام کن
							<span class="arrow">←</span>
						</a>

						<a href="#introduction" class="btn btn-ghost btn-large">
							بیشتر بدانید
						</a>
					</div>
				</div>

				<!-- Search Mockup -->
				<div class="hero-visual">
					<div class="floating-card floating-card-one">
						<div class="mini-icon icon-document">
							<svg viewBox="0 0 24 24">
								<path d="M7 3h7l4 4v14H7z"></path>
								<path d="M14 3v5h5"></path>
								<path d="M10 13h5M10 17h5"></path>
							</svg>
						</div>
					</div>

					<div class="floating-card floating-card-two">
						<div class="mini-icon icon-user">
							<svg viewBox="0 0 24 24">
								<circle cx="12" cy="8" r="3"></circle>
								<path d="M5 21c.7-4 3-6 7-6s6.3 2 7 6"></path>
							</svg>
						</div>
					</div>

					<div class="search-panel">
						<div class="search-input">
							<span class="search-placeholder"
								>جستجو در قیمت‌ها...</span
							>

							<button class="search-button">
								<svg viewBox="0 0 24 24">
									<circle cx="10.8" cy="10.8" r="6.8"
									></circle>
									<path d="m16 16 5 5"></path>
								</svg>
							</button>
						</div>

						<div class="offer-list">
							<div class="offer">
								<div class="offer-icon">
									<span></span>
								</div>

								<div class="offer-info">
									<strong>آیفون ۱۵</strong>
									<span>فروشگاه موبایل مرکزی</span>
								</div>

								<div class="offer-price">
									<strong>۵۲,۵۰۰,۰۰۰</strong>
									<span>تومان</span>
								</div>

								<div class="phone-icon">
									<svg viewBox="0 0 24 24">
										<path
											d="M6 3h4l2 5-2.5 2a13 13 0 0 0 4.5 4.5l2-2.5 5 2v4c0 1-1 2-2 2C10 20 4 14 4 5c0-1 1-2 2-2z"
										></path>
									</svg>
								</div>
							</div>

							<div class="offer">
								<div class="offer-icon offer-icon-purple">
									<span></span>
								</div>

								<div class="offer-info">
									<strong>سامسونگ S24 Ultra</strong>
									<span>موبایل پارس</span>
								</div>

								<div class="offer-price">
									<strong>۷۸,۲۰۰,۰۰۰</strong>
									<span>تومان</span>
								</div>

								<div class="phone-icon">
									<svg viewBox="0 0 24 24">
										<path
											d="M6 3h4l2 5-2.5 2a13 13 0 0 0 4.5 4.5l2-2.5 5 2v4c0 1-1 2-2 2C10 20 4 14 4 5c0-1 1-2 2-2z"
										></path>
									</svg>
								</div>
							</div>

							<div class="offer">
								<div class="offer-icon offer-icon-blue">
									<span></span>
								</div>

								<div class="offer-info">
									<strong>Apple Watch</strong>
									<span>دیجیتال مارکت</span>
								</div>

								<div class="offer-price">
									<strong>۲۴,۹۰۰,۰۰۰</strong>
									<span>تومان</span>
								</div>

								<div class="phone-icon">
									<svg viewBox="0 0 24 24">
										<path
											d="M6 3h4l2 5-2.5 2a13 13 0 0 0 4.5 4.5l2-2.5 5 2v4c0 1-1 2-2 2C10 20 4 14 4 5c0-1 1-2 2-2z"
										></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Problem -->
			<section id="introduction" class="introduction section">
				<div class="introduction-content">
					<div class="section-label">همکار چیست؟</div>

					<h2>
						قیمت‌های همکارانت را
						<span>یکجا پیدا کن.</span>
					</h2>

					<p>
						همکار یک شبکه برای فروشندگان است تا به‌جای پرسیدن قیمت
						از چند نفر، بتوانند قیمت‌های به‌روز محصولات را از
						همکارانشان پیدا کنند.
					</p>

					<p>
						هر فروشنده خودش تعیین می‌کند چه کسانی به قیمت‌هایش
						دسترسی داشته باشند؛ بنابراین اطلاعات قیمت‌ها فقط در
						اختیار همکاران مورد اعتماد قرار می‌گیرد.
					</p>
				</div>

				<div class="introduction-visual">
					<div class="intro-card">
						<div class="intro-card-header">
							<span>قیمت‌های امروز</span>
							<span class="intro-status">به‌روز</span>
						</div>

						<div class="intro-offer">
							<div class="intro-product">
								<strong>آیفون ۱۵</strong>
								<span>موبایل مرکزی</span>
							</div>

							<div class="intro-price">
								<strong>۵۲,۵۰۰,۰۰۰</strong>
								<span>تومان</span>
							</div>
						</div>

						<div class="intro-offer">
							<div class="intro-product">
								<strong>سامسونگ S24 Ultra</strong>
								<span>موبایل پارس</span>
							</div>

							<div class="intro-price">
								<strong>۷۸,۲۰۰,۰۰۰</strong>
								<span>تومان</span>
							</div>
						</div>

						<div class="intro-offer">
							<div class="intro-product">
								<strong>Apple Watch</strong>
								<span>دیجیتال مارکت</span>
							</div>

							<div class="intro-price">
								<strong>۲۴,۹۰۰,۰۰۰</strong>
								<span>تومان</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- How it works -->
			<section id="how-it-works" class="how section">
				<div class="center-heading">
					<div class="section-label">نحوه کار</div>

					<h2>
						شروع کار با همکار
						<span>ساده‌تر از چیزی است که فکر می‌کنی.</span>
					</h2>

					<p>
						در چند قدم ساده به قیمت‌های به‌روز همکارانت دسترسی پیدا
						کن.
					</p>
				</div>

				<div class="steps">
					<div class="step">
						<div class="step-number">۱</div>

						<div class="step-content">
							<h3>ثبت‌نام کن</h3>
							<p>
								با شماره موبایل ثبت‌نام کن و پروفایل فروشندگی
								خودت را بساز.
							</p>
						</div>
					</div>

					<div class="step-line"></div>

					<div class="step">
						<div class="step-number">۲</div>

						<div class="step-content">
							<h3>همکارت را پیدا کن</h3>
							<p>
								فروشندگان موردنظرت را جستجو کن و پروفایل آن‌ها
								را ببین.
							</p>
						</div>
					</div>

					<div class="step-line"></div>

					<div class="step">
						<div class="step-number">۳</div>

						<div class="step-content">
							<h3>درخواست دسترسی بده</h3>
							<p>
								برای دیدن قیمت‌های یک فروشنده، درخواست دسترسی
								ارسال کن.
							</p>
						</div>
					</div>

					<div class="step-line"></div>

					<div class="step">
						<div class="step-number">۴</div>

						<div class="step-content">
							<h3>قیمت‌ها را ببین</h3>
							<p>
								بعد از تأیید، قیمت‌های به‌روز محصولات آن فروشنده
								را ببین.
							</p>
						</div>
					</div>
				</div>
			</section>

